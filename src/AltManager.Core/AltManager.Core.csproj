<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required by the [LibraryImport] P/Invoke source generator -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AltManager.Core</RootNamespace>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI (ProtectedData) is not in the base framework on .NET 8 -->
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
