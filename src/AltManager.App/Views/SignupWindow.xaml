<Window x:Class="AltManager.App.Views.SignupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Create a Roblox account" Width="520" Height="760" MinWidth="480" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgSolid}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource PopupBg}" Padding="10,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Reload" Padding="10,2" Click="Reload_Click"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                           Text="Fill in the sign-up form and solve the puzzle if it appears. This window closes automatically once the account is created, and it's added to the manager."
                           TextWrapping="Wrap" Margin="0,0,10,0"/>
            </DockPanel>
        </Border>
        <!-- Never collapse/hide/zero-size this control: the Arkose iframe will not paint. -->
        <wv2:WebView2 x:Name="Browser"/>
    </DockPanel>
</Window>
