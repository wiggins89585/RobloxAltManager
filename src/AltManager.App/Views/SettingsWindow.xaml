<Window x:Class="AltManager.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="720" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Left column ============ -->
        <StackPanel Grid.Row="0" Grid.Column="0">

            <TextBlock Text="STARTUP" Style="{StaticResource Heading}"/>
            <CheckBox x:Name="LaunchOnStartup" Content="Load Alt Manager when I sign in to Windows"
                      Margin="0,8,0,4" Foreground="{DynamicResource Fg}"/>
            <CheckBox x:Name="AlwaysOnTop" Content="Keep the app window on top of other windows"
                      Margin="0,4,0,0" Foreground="{DynamicResource Fg}"/>

            <Border Height="1" Background="{DynamicResource Line}" Margin="0,12"/>

            <TextBlock Text="ACCOUNT HEALTH" Style="{StaticResource Heading}"/>
            <CheckBox x:Name="AutoStartup" Content="Re-check all accounts on startup" Margin="0,8,0,4" Foreground="{DynamicResource Fg}"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="Auto re-check every" VerticalAlignment="Center" Foreground="{DynamicResource Fg}"/>
                <TextBox x:Name="Interval" Width="48" Margin="8,0,6,0"/>
                <TextBlock Text="minutes (0 = off)" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
            </StackPanel>
            <CheckBox x:Name="ParallelBrowser" Content="Do bulk logins and group joins all at once"
                      Margin="0,8,0,0" Foreground="{DynamicResource Fg}"/>
            <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="24,2,0,0" Foreground="#F0B232"
                       Text="Warning: this probably won't work well. Roblox is likely to rate-limit you or show more puzzles, and every account opens its own window."/>
            <CheckBox x:Name="AutoRejoin" Content="Auto-rejoin a client into its game if it closes unexpectedly"
                      Margin="0,8,0,0" Foreground="{DynamicResource Fg}"/>

            <Border Height="1" Background="{DynamicResource Line}" Margin="0,12"/>

            <TextBlock Text="LOCAL AUTOMATION API" Style="{StaticResource Heading}"/>
            <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap"
                       Text="Localhost-only HTTP API so scripts, Stream Deck or hotkey tools can list and launch accounts. Binds to 127.0.0.1 only; every request needs the token below."/>
            <CheckBox x:Name="ApiEnabled" Content="Enable the local API" Margin="0,8,0,4" Foreground="{DynamicResource Fg}"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="Port" VerticalAlignment="Center" Foreground="{DynamicResource Fg}"/>
                <TextBox x:Name="ApiPort" Width="64" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Token (send as 'Authorization: Bearer &lt;token&gt;')" Style="{StaticResource Label}" Margin="0,8,0,2"/>
            <TextBox x:Name="ApiToken" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Copy token" Click="CopyToken_Click"/>
                <Button Content="Regenerate" Click="RegenToken_Click"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="GET /ping · GET /accounts · GET /groups · POST /launch {&quot;game&quot;,&quot;accounts&quot;,&quot;group&quot;}"/>

            <Border Height="1" Background="{DynamicResource Line}" Margin="0,12"/>

            <TextBlock Text="EMAIL CODES" Style="{StaticResource Heading}"/>
            <Button Content="Manage inboxes…" HorizontalAlignment="Left" Margin="0,6,0,0" Click="Inboxes_Click"/>

            <Border Height="1" Background="{DynamicResource Line}" Margin="0,12"/>

            <TextBlock Text="VAULT BACKUP" Style="{StaticResource Heading}"/>
            <TextBlock Text="The backup is the encrypted vault file; it needs the same master password to open." Style="{StaticResource Label}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Export vault…" Click="Export_Click"/>
                <Button Content="Import vault…" Click="Import_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- ============ Right column ============ -->
        <StackPanel Grid.Row="0" Grid.Column="2">

            <TextBlock Text="UPDATES" Style="{StaticResource Heading}"/>
            <CheckBox x:Name="AutoUpdate" Content="Automatically download and install updates"
                      Margin="0,8,0,0" Foreground="{DynamicResource Fg}"/>

            <Border Height="1" Background="{DynamicResource Line}" Margin="0,12"/>

            <TextBlock Text="PRIVACY" Style="{StaticResource Heading}"/>
            <CheckBox x:Name="Streamer" Content="Streamer mode — mask usernames and IDs" Margin="0,8,0,4" Foreground="{DynamicResource Fg}"/>
            <CheckBox x:Name="ConfirmCopy" Content="Confirm before copying a password" Margin="0,4,0,4" Foreground="{DynamicResource Fg}"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="Clear clipboard" VerticalAlignment="Center" Foreground="{DynamicResource Fg}"/>
                <TextBox x:Name="ClipClear" Width="48" Margin="8,0,6,0"/>
                <TextBlock Text="s after copying (0 = never)" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Auto-lock after" VerticalAlignment="Center" Foreground="{DynamicResource Fg}"/>
                <TextBox x:Name="AutoLock" Width="48" Margin="8,0,6,0"/>
                <TextBlock Text="min idle (0 = off)" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource Line}" Margin="0,12"/>

            <TextBlock Text="THEME" Style="{StaticResource Heading}"/>
            <TextBlock Text="Pick a theme preset; tweak the accent below. Previews live — Cancel reverts."
                       Style="{StaticResource Label}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Theme" VerticalAlignment="Center" Foreground="{DynamicResource Fg}"/>
                <ComboBox x:Name="ThemeBox" Width="160" Margin="8,0,0,0" SelectionChanged="ThemeBox_Changed"/>
            </StackPanel>
            <TextBlock Text="Accent" Style="{StaticResource Label}" Margin="0,10,0,2"/>
            <WrapPanel x:Name="AccentSwatches" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Hex" VerticalAlignment="Center" Foreground="{DynamicResource Fg}"/>
                <TextBox x:Name="AccentHex" Width="92" Margin="8,0,8,0" MaxLength="9"/>
                <Border x:Name="AccentPreview" Width="24" Height="24" CornerRadius="4"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1"/>
            </StackPanel>
            <TextBlock Text="Liquid Glass frost (clear ↔ frosted)" Style="{StaticResource Label}" Margin="0,10,0,2"/>
            <Slider x:Name="FrostSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                    ValueChanged="FrostSlider_Changed"/>

            <Border Height="1" Background="{DynamicResource Line}" Margin="0,12"/>

            <TextBlock Text="VIEW" Style="{StaticResource Heading}"/>
            <CheckBox x:Name="RememberView" Content="Remember view, group and window size between sessions"
                      Margin="0,8,0,4" Foreground="{DynamicResource Fg}"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="Card width (grid view)" VerticalAlignment="Center" Foreground="{DynamicResource Fg}"/>
                <TextBox x:Name="CardWidth" Width="56" Margin="8,0,0,0"/>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource Line}" Margin="0,12"/>

            <TextBlock Text="BROWSER" Style="{StaticResource Heading}"/>
            <TextBlock Text="Custom User-Agent (blank = engine default; recommended)" Style="{StaticResource Label}" TextWrapping="Wrap"/>
            <TextBox x:Name="UserAgent" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- ============ Buttons ============ -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Save" Width="90" IsDefault="True" Click="Save_Click" Style="{StaticResource AccentButton}"/>
            <Button Content="Cancel" Width="90" IsCancel="True" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
