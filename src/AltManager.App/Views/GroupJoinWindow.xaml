<Window x:Class="AltManager.App.Views.GroupJoinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Join Roblox group" Width="620" Height="760" MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" Padding="10,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Stop all" Padding="10,2" Margin="0" Click="Stop_Click"/>
                <Button DockPanel.Dock="Right" Content="Skip" Padding="10,2" Click="Skip_Click"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource Fg}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,10,0"/>
            </DockPanel>
        </Border>
        <wv2:WebView2 x:Name="Browser"/>
    </DockPanel>
</Window>
