<Window x:Class="AltManager.App.Views.GroupPayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Give Group Robux" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}">
    <StackPanel Margin="16">
        <TextBlock Text="Pay Robux from a group you own to the selected accounts (one-time group payout)."
                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/>

        <TextBlock Text="Payer (group owner account)" Style="{StaticResource Label}"/>
        <!-- An explicit template: the app's ComboBox style shows the item itself in the closed box, so
             DisplayMemberPath alone printed the class name there. Type a name to jump to it. -->
        <ComboBox x:Name="PayerBox" Height="28" IsTextSearchEnabled="True" TextSearch.TextPath="Label" MaxDropDownHeight="320">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="Robux" Text="{Binding RobuxText, StringFormat='{}  ·  {0} R$'}" Foreground="{DynamicResource Muted}"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding RobuxValue}" Value="-1">
                            <Setter TargetName="Robux" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Group ID" Style="{StaticResource Label}"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Check funds" Margin="6,0,0,0" Click="CheckFunds_Click"/>
            <TextBox x:Name="GroupBox"/>
        </DockPanel>
        <TextBlock x:Name="FundsText" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/>

        <TextBlock Text="Robux to each account" Style="{StaticResource Label}"/>
        <TextBox x:Name="AmountBox" Text="1" TextChanged="Amount_TextChanged"/>

        <TextBlock Text="Recipients" Style="{StaticResource Label}"/>
        <Border Background="{DynamicResource Panel}" CornerRadius="5" Padding="6" MaxHeight="140">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Recipients">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" FontSize="12" Margin="2,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="TotalText" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <!-- Per-account result of the last payout -->
        <TextBox x:Name="ResultBox" IsReadOnly="True" Visibility="Collapsed" Margin="0,6,0,0" MaxHeight="150"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11"/>
        <TextBlock Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="Recipients must already be in the group. If Roblox asks for 2-step verification, save the payer's authenticator key first (right-click the payer → Edit → Set 2FA secret)."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="PayButton" Content="Pay" Width="100" Style="{StaticResource AccentButton}" Click="Pay_Click"/>
            <Button Content="Close" Width="90" IsCancel="True" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
