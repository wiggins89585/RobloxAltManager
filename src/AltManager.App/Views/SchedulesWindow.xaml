<Window x:Class="AltManager.App.Views.SchedulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scheduled Launches" Width="500" Height="520" MinWidth="420" MinHeight="340"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Launch a group into a game at a set time each day. The app must be running for a schedule to fire."/>

        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Group" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="GroupBox" IsEditable="True"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Time (HH:mm)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TimeBox" Text="12:00"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Game (place ID or link)" Style="{StaticResource Label}"/>
                <TextBox x:Name="GameBox"/>
                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="Add schedule" Style="{StaticResource AccentButton}" Click="Add_Click"/>
                    <CheckBox x:Name="DailyBox" Content="Repeat daily" IsChecked="True" VerticalAlignment="Center"
                              Foreground="{DynamicResource Fg}"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource Panel}" CornerRadius="6" ClipToBounds="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="8,5">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                          Margin="0,0,8,0" Click="Toggle_Click"/>
                                <Button DockPanel.Dock="Right" Content="✕" Padding="7,1" Click="Remove_Click"
                                        ToolTip="Remove schedule"/>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" FontSize="12">
                                        <Run Text="{Binding Time, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding GroupLabel, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
