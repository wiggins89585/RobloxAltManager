<Window x:Class="AltManager.App.Views.BulkLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Import (user:pass)" Width="520" Height="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1F22" Foreground="#DBDEE1">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12"
                   Text="Paste accounts as user:pass,user:pass,user:pass, or paste each username and password one at a time. When pasted one at a time, the : and , are added automatically. Or Import from file to pull a browser password export (CSV) — only the Roblox logins are kept. Each account opens in a browser; complete any verification there. Passwords are not saved."/>
        <TextBox x:Name="InputBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Group:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="GroupCombo" Width="150" IsEditable="True"/>
            <TextBlock Text="Delay (s):" VerticalAlignment="Center" Margin="12,0,6,0"
                       ToolTip="Wait between logins so Roblox doesn't rate-limit you"/>
            <TextBox x:Name="DelayBox" Width="40" Text="2"
                     ToolTip="Wait between logins so Roblox doesn't rate-limit you"/>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#949BA4" FontSize="11"/>
        </StackPanel>
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" Content="Import from file…" Click="Import_Click"
                    ToolTip="Import a browser password export (CSV). Only Roblox logins are added; other sites are skipped."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Start" Width="90" IsDefault="True" Click="Start_Click" Style="{StaticResource AccentButton}"/>
                <Button Content="Cancel" Width="90" IsCancel="True" Margin="0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
