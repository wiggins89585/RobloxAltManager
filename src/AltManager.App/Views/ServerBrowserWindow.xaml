<Window x:Class="AltManager.App.Views.ServerBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Servers" Width="460" Height="600" MinWidth="380" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Fg}">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Refresh" Margin="6,0,0,0" Click="Refresh_Click"/>
            <TextBlock x:Name="HeaderText" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </DockPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Join emptiest" Click="JoinEmptiest_Click" ToolTip="Join the server with the most free slots"/>
            <Button Content="Join fullest" Click="JoinFullest_Click" ToolTip="Join the most populated non-full server"/>
            <Button Content="Server hop (random)" Click="JoinRandom_Click"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                   Text="Double-click a server to join the selected accounts there."/>

        <Border CornerRadius="6" Background="{StaticResource Panel}" ClipToBounds="True">
            <ListBox x:Name="ServerList" Background="Transparent" BorderThickness="0"
                     MouseDoubleClick="ServerList_DoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Right}" Foreground="{StaticResource Muted}"
                                       FontSize="11" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Players}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Id}" Foreground="{StaticResource Muted}" FontSize="10"
                                           Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
