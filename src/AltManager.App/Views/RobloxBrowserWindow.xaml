<Window x:Class="AltManager.App.Views.RobloxBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roblox" WindowStyle="None" Width="1100" Height="760" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Line}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <DockPanel>
            <!-- ================= Custom title bar ================= -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource Bg}" Height="38"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <!-- Window caption buttons -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"/>
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize"/>
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
                    </StackPanel>

                    <!-- Navigation -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="◀" Padding="8,2" Click="Back_Click" ToolTip="Back"/>
                        <Button Content="▶" Padding="8,2" Click="Forward_Click" ToolTip="Forward"/>
                        <Button Content="⟳" Padding="8,2" Click="Reload_Click" ToolTip="Reload"/>
                        <Button Content="Home" Padding="10,2" Margin="4,0,0,0" Click="Home_Click"/>
                    </StackPanel>

                    <!-- Account label -->
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                               DockPanel.Dock="Right" MaxWidth="190" Margin="8,0,10,0"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBox x:Name="UrlBox" VerticalAlignment="Center" Height="26" Margin="8,0"
                             WindowChrome.IsHitTestVisibleInChrome="True"
                             Padding="7,3" ToolTip="Roblox page URL — press Enter to navigate"
                             Text="https://www.roblox.com/home" KeyDown="UrlBox_KeyDown"/>
                </DockPanel>
            </Border>

            <!-- ================= Tabs ================= -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource Bg}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <DockPanel Margin="6,3">
                    <Button DockPanel.Dock="Right" Content="+" Padding="10,2" Margin="4,0,0,0"
                            Click="NewTab_Click" ToolTip="New tab (Ctrl+T)"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TabStrip" Orientation="Horizontal"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid x:Name="Pages"/>
        </DockPanel>
    </Border>
</Window>
