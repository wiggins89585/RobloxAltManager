<Window x:Class="AltManager.App.Views.RobloxBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Roblox" Width="1100" Height="760" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Line}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <DockPanel>
            <!-- ================= Custom title bar ================= -->
            <Border DockPanel.Dock="Top" Background="{StaticResource Bg}" Height="38">
                <DockPanel>
                    <!-- Window caption buttons -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"/>
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize"/>
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
                    </StackPanel>

                    <!-- Navigation -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="◀" Padding="8,2" Click="Back_Click" ToolTip="Back"/>
                        <Button Content="▶" Padding="8,2" Click="Forward_Click" ToolTip="Forward"/>
                        <Button Content="⟳" Padding="8,2" Click="Reload_Click" ToolTip="Reload"/>
                        <Button Content="Home" Padding="10,2" Margin="4,0,0,0" Click="Home_Click"/>
                    </StackPanel>

                    <!-- Account label (also the draggable area) -->
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                               Margin="12,0,12,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <wv2:WebView2 x:Name="Browser"/>
        </DockPanel>
    </Border>
</Window>
