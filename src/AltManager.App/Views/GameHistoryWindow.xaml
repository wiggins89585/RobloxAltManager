<Window x:Class="AltManager.App.Views.GameHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game History" Width="560" Height="620" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Fg}">

    <Window.Resources>
        <ContextMenu x:Key="GameMenu">
            <MenuItem Header="Copy Place Link" Click="CopyLink_Click"/>
            <MenuItem Header="Copy PlaceId" Click="CopyId_Click"/>
            <MenuItem Header="Copy Name" Click="CopyName_Click"/>
            <MenuItem Header="Copy Place Details" Click="CopyDetails_Click"/>
            <Separator/>
            <MenuItem Header="Use in Launch" Click="Use_Click"/>
            <MenuItem Header="Remove from history" Click="Remove_Click"/>
        </ContextMenu>
    </Window.Resources>

    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" x:Name="CountText" VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{StaticResource Muted}" FontSize="11"/>
            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
                     ToolTip="Filter by game name or place ID"/>
        </DockPanel>

        <TextBlock x:Name="EmptyText" Text="No games launched yet. Launch a game and it'll show up here."
                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" Visibility="Collapsed"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Items">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="126"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,8" Padding="4" CornerRadius="6" Cursor="Hand"
                                Background="{StaticResource Panel}"
                                ContextMenu="{StaticResource GameMenu}"
                                MouseLeftButtonUp="Card_Click" ToolTip="{Binding Name}">
                            <StackPanel>
                                <Border Width="114" Height="114" CornerRadius="6" ClipToBounds="True"
                                        Background="{StaticResource Raised}">
                                    <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Margin="2,4,2,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="114"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{StaticResource Muted}"
                                           Margin="2,0,2,2" TextTrimming="CharacterEllipsis" MaxWidth="114"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
