<Window x:Class="AltManager.App.Views.InboxesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Email inboxes" Width="460" Height="520" MinWidth="400" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="When a login asks for an email code, these inboxes are checked and the code is entered for you. Only Roblox's emails are read."/>

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="Provider" Style="{StaticResource Label}" Margin="0,10,0,2"/>
            <ComboBox x:Name="Provider" SelectionChanged="Provider_Changed"/>
            <TextBlock x:Name="Hint" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="Email address" Style="{StaticResource Label}" Margin="0,8,0,2"/>
            <TextBox x:Name="Address"/>
            <TextBlock x:Name="PasswordLabel" Text="App password" Style="{StaticResource Label}" Margin="0,8,0,2"/>
            <PasswordBox x:Name="Password"/>
            <StackPanel x:Name="ServerRow" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Server" VerticalAlignment="Center"/>
                <TextBox x:Name="Host" Width="210" Margin="8,0,12,0"/>
                <TextBlock Text="Port" VerticalAlignment="Center"/>
                <TextBox x:Name="Port" Width="60" Margin="8,0,0,0"/>
            </StackPanel>
            <DockPanel Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" x:Name="AddButton" Content="Test and add" Margin="0"
                        Click="Add_Click" Style="{StaticResource AccentButton}"/>
                <TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </DockPanel>
        </StackPanel>

        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Remove" VerticalAlignment="Top" Margin="6,0,0,0" Click="Remove_Click"/>
            <ListBox x:Name="List" DisplayMemberPath="Address" Background="{DynamicResource Panel}"
                     Foreground="{DynamicResource Fg}" BorderThickness="0"/>
        </DockPanel>
    </DockPanel>
</Window>
